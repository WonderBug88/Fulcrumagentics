---
import '../styles/globals.css';
import { siteConfig } from '../config.ts';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';

const pageTitle = 'Use Case: From ETL to Workflow Brain | Fulcrum Agentics';
const pageDescription =
  'How Fulcrum Agentics evolved an ETL framework into a product workflow brain with diagnostic tests, normalization lanes, human review, automated fixes, blocked paths, and Golden Fixture status.';
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta
      name="keywords"
      content="workflow diagnostics, product data automation, ETL framework, golden fixture, supplier data normalization, human in the loop AI, fulfillment automation, catalog automation, AI employees"
    />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="article" />
    <meta property="og:image" content="/assets/fulcrum-mark-og.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content="/assets/fulcrum-mark-og.png" />

    <script is:inline>
      (() => {
        const key = 'fa-theme';
        const root = document.documentElement;
        let saved = 'light';
        try {
          saved = localStorage.getItem(key) === 'dark' ? 'dark' : 'light';
        } catch {}
        root.classList.remove('theme-light', 'theme-dark');
        root.classList.add(saved === 'dark' ? 'theme-dark' : 'theme-light');
      })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@100..900&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <Navigation />

    <main class="use-case-page">
      <section class="use-hero mono-mesh">
        <div class="site-shell use-hero-grid">
          <div class="use-hero-copy scroll-fade-up">
            <p class="eyebrow">Fulcrum Agentics Use Case</p>
            <h1>We didn’t build an ETL. We built a workflow brain.</h1>
            <p class="lead">
              The project started as supplier normalization. It became a diagnostic system for product drift, downstream risk, automated repairs, human review, and Golden Fixture readiness.
            </p>
            <div class="hero-actions">
              <a class="btn btn-primary" href={siteConfig.navigation.cta.href}>Discuss this workflow</a>
              <a class="btn btn-secondary" href="#infographic">View the infographic</a>
            </div>
          </div>

          <aside class="hero-panel fa-surface scroll-fade-left" aria-label="Golden Fixture summary">
            <p class="panel-kicker">Outcome</p>
            <strong>Golden Fixture status</strong>
            <span>
              A product is trusted only after the diagnostic workflow proves it is complete, consistent, and safe for downstream systems.
            </span>
          </aside>
        </div>
      </section>

      <section class="story-section fa-section">
        <div class="site-shell story-grid">
          <article class="story-card fa-surface scroll-fade-up">
            <p class="eyebrow">The problem</p>
            <h2>Product workflows drift over years.</h2>
            <p>
              Supplier files were only the first layer. Product records, merchandising logic, option structures, pricing tiers, logistics, SEO, manual edits, and API behavior had all drifted. Moving data faster did not solve the problem. It made fragile workflows more visible.
            </p>
          </article>
          <article class="story-card fa-surface scroll-fade-up">
            <p class="eyebrow">The crash</p>
            <h2>Programming products exposed hidden dependencies.</h2>
            <p>
              When updates moved through scripts and GraphQL, every change had a chain reaction. A field update could affect variants, storefront behavior, review status, publishing, or another downstream process. The work became chess-like: every move had to account for what could break later.
            </p>
          </article>
          <article class="story-card fa-surface scroll-fade-up">
            <p class="eyebrow">The shift</p>
            <h2>Normalization became a routing system.</h2>
            <p>
              Fulcrum stopped treating ETL as a straight line. Products now move through lanes: automated fixes when confidence is high, human review when judgment is needed, and blocked states when a new test or solution script must be built.
            </p>
          </article>
        </div>
      </section>

      <section id="infographic" class="infographic-section fa-section">
        <div class="site-shell">
          <div class="section-heading scroll-fade-up">
            <p class="eyebrow">The infographic</p>
            <h2>From data pipeline to workflow brain</h2>
            <p>
              The framework evolved from extract-transform-load into an operating loop that diagnoses, scores, routes, repairs, reviews, blocks, retests, and publishes only when the product reaches Golden Fixture quality.
            </p>
          </div>

          <div class="infographic fa-surface scroll-fade-up" role="img" aria-label="Infographic explaining how Fulcrum evolved from ETL to a workflow brain">
            <div class="info-header">
              <span>We didn’t build an ETL.</span>
              <strong>We built a workflow brain.</strong>
              <small>1,000+ diagnostic tests driving Golden Fixture quality</small>
            </div>

            <div class="journey-row">
              <div class="journey-card">
                <b>1</b>
                <h3>ETL mindset</h3>
                <p>Extract, transform, and load supplier data.</p>
              </div>
              <div class="journey-arrow">→</div>
              <div class="journey-card">
                <b>2</b>
                <h3>Reality hit</h3>
                <p>Products drifted. Rules changed. Manual edits accumulated.</p>
              </div>
              <div class="journey-arrow">→</div>
              <div class="journey-card">
                <b>3</b>
                <h3>Scale crashed</h3>
                <p>GraphQL updates revealed fragile downstream dependencies.</p>
              </div>
              <div class="journey-arrow">→</div>
              <div class="journey-card">
                <b>4</b>
                <h3>Workflow reimagined</h3>
                <p>Probability scoring, tiers, tests, and orchestration.</p>
              </div>
              <div class="journey-arrow">→</div>
              <div class="journey-card gold">
                <b>5</b>
                <h3>Workflow brain</h3>
                <p>Diagnostics, lanes, scripts, and Golden Fixture readiness.</p>
              </div>
            </div>

            <div class="modern-workflow">
              <h3>The modern Fulcrum workflow</h3>
              <div class="workflow-steps">
                <span>Ingest</span>
                <span>Understand product</span>
                <span>Run diagnostics</span>
                <span>Score risk</span>
                <span>Route lane</span>
                <span>Orchestrate fix</span>
                <span>Golden Fixture</span>
              </div>
            </div>

            <div class="lanes">
              <div class="lane automated">
                <div>
                  <h3>Automated fix lane</h3>
                  <p>High confidence. Known issue. Known solution script.</p>
                </div>
                <span>Identify → Fix → Retest → Pass</span>
              </div>
              <div class="lane review">
                <div>
                  <h3>Human review lane</h3>
                  <p>Ambiguous data, business context, or judgment required.</p>
                </div>
                <span>Review → Decide → Resolve → Retest</span>
              </div>
              <div class="lane blocked">
                <div>
                  <h3>Blocked lane</h3>
                  <p>No viable solution yet. New edge case or high risk.</p>
                </div>
                <span>Document → Analyze → Build test → Reroute</span>
              </div>
              <div class="gold-box">
                <strong>Golden Fixture</strong>
                <ul>
                  <li>All required tests passed</li>
                  <li>Complete and consistent data</li>
                  <li>Safe for downstream workflows</li>
                  <li>Publish-ready and trusted</li>
                </ul>
              </div>
            </div>

            <div class="impact-row">
              <div><strong>Quality first</strong><span>We do not just move data.</span></div>
              <div><strong>Risk reduction</strong><span>Predict and prevent downstream breaks.</span></div>
              <div><strong>Efficiency</strong><span>Automate what can be automated.</span></div>
              <div><strong>Continuous learning</strong><span>Every block teaches the system.</span></div>
            </div>
          </div>
        </div>
      </section>

      <section class="article-section fa-section">
        <div class="site-shell article-grid">
          <article class="article-copy scroll-fade-up">
            <p class="eyebrow">Use case narrative</p>
            <h2>What changed when Fulcrum went deeper than ETL</h2>
            <p>
              The first version normalized supplier input. That was useful, but limited. Once Fulcrum began programming product updates through scripts, the team found the real bottleneck: the product workflow itself had accumulated years of drift.
            </p>
            <p>
              So the architecture changed. Instead of one linear pipeline, Fulcrum built a diagnostic loop with more than 1,000 tests and solution scripts. The system evaluates product readiness, estimates downstream breakage risk, chooses a normalization lane, and keeps humans in the loop where judgment matters.
            </p>
            <p>
              The result is not a faster import button. It is a workflow brain that knows when to automate, when to escalate, when to block, and when a product can be trusted as a Golden Fixture.
            </p>
          </article>

          <aside class="quote-card fa-surface scroll-fade-left">
            <span>Core idea</span>
            <blockquote>
              “An ETL should not just transport data. It should understand whether the workflow produced a trustworthy result.”
            </blockquote>
          </aside>
        </div>
      </section>

      <section class="cta-section">
        <div class="site-shell cta-card fa-surface scroll-fade-up">
          <div>
            <p class="eyebrow">Build the workflow brain</p>
            <h2>Have a workflow that keeps breaking downstream?</h2>
            <p>
              Send the source records, the approval step, the system of record, and what currently breaks. Fulcrum will help identify what should be automated, reviewed, blocked, or rebuilt as a diagnostic workflow.
            </p>
          </div>
          <a class="btn btn-primary" href={siteConfig.navigation.cta.href}>Discuss an AI Employee</a>
        </div>
      </section>
    </main>

    <Footer />

    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const observerOptions = {
          threshold: 0.1,
          rootMargin: '0px 0px -100px 0px',
        };
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
            }
          });
        }, observerOptions);
        const scrollFadeElements = document.querySelectorAll(
          '.scroll-fade, .scroll-fade-up, .scroll-fade-down, .scroll-fade-left, .scroll-fade-right',
        );
        scrollFadeElements.forEach((el) => observer.observe(el));
      });
    </script>
  </body>
</html>

<style>
  .use-case-page {
    background: var(--color-bg);
    color: var(--color-text);
  }

  .use-hero {
    padding: 7rem 0 4rem;
  }

  .use-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(280px, 0.7fr);
    gap: 2rem;
    align-items: center;
  }

  .eyebrow {
    color: var(--color-brand-amber);
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    margin: 0 0 0.75rem;
    text-transform: uppercase;
  }

  .use-hero h1 {
    font-size: clamp(3rem, 8vw, 6.75rem);
    letter-spacing: -0.08em;
    line-height: 0.88;
    margin: 0;
    max-width: 960px;
  }

  .lead {
    color: var(--color-text-muted);
    font-size: clamp(1.1rem, 2vw, 1.45rem);
    line-height: 1.5;
    margin: 1.5rem 0 0;
    max-width: 760px;
  }

  .hero-actions,
  .cta-card {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
  }

  .hero-panel {
    padding: 2rem;
  }

  .hero-panel strong {
    display: block;
    font-size: 2rem;
    line-height: 1.05;
    margin-bottom: 1rem;
  }

  .hero-panel span,
  .story-card p,
  .section-heading p,
  .article-copy p,
  .cta-card p,
  .quote-card blockquote {
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  .panel-kicker {
    color: var(--color-brand-amber);
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .story-section,
  .infographic-section,
  .article-section,
  .cta-section {
    padding: 4rem 0;
  }

  .story-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .story-card {
    padding: 1.5rem;
  }

  .story-card h2,
  .section-heading h2,
  .article-copy h2,
  .cta-card h2 {
    font-size: clamp(2rem, 4vw, 3.7rem);
    letter-spacing: -0.06em;
    line-height: 0.95;
    margin: 0 0 1rem;
  }

  .section-heading {
    margin: 0 auto 2rem;
    max-width: 850px;
    text-align: center;
  }

  .infographic {
    overflow: hidden;
    padding: clamp(1rem, 3vw, 2rem);
  }

  .info-header {
    border-bottom: 1px solid var(--color-border);
    display: grid;
    gap: 0.3rem;
    padding-bottom: 1.5rem;
    text-align: center;
  }

  .info-header span,
  .info-header strong {
    display: block;
    font-size: clamp(2rem, 5vw, 4.5rem);
    font-weight: 900;
    letter-spacing: -0.08em;
    line-height: 0.95;
    text-transform: uppercase;
  }

  .info-header strong {
    color: var(--color-brand-amber);
  }

  .info-header small {
    color: var(--color-text-muted);
    font-size: 1rem;
  }

  .journey-row {
    align-items: stretch;
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr auto 1fr auto 1fr;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .journey-card {
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    min-height: 180px;
    padding: 1rem;
  }

  .journey-card b {
    align-items: center;
    background: var(--color-brand-slate);
    border-radius: 999px;
    color: white;
    display: inline-flex;
    height: 2rem;
    justify-content: center;
    margin-bottom: 1rem;
    width: 2rem;
  }

  .journey-card.gold b,
  .gold-box {
    background: color-mix(in srgb, var(--color-brand-amber) 18%, var(--color-surface));
    border-color: color-mix(in srgb, var(--color-brand-amber) 55%, var(--color-border));
  }

  .journey-card h3,
  .modern-workflow h3,
  .lane h3 {
    font-size: 0.95rem;
    letter-spacing: -0.03em;
    margin: 0 0 0.75rem;
    text-transform: uppercase;
  }

  .journey-card p,
  .lane p,
  .impact-row span {
    color: var(--color-text-muted);
    line-height: 1.55;
    margin: 0;
  }

  .journey-arrow {
    align-self: center;
    color: var(--color-text-soft);
    font-size: 1.5rem;
    font-weight: 900;
  }

  .modern-workflow {
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    margin-top: 1.5rem;
    padding: 1.5rem;
    text-align: center;
  }

  .workflow-steps {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    margin-top: 1rem;
  }

  .workflow-steps span {
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 800;
    padding: 0.75rem;
  }

  .lanes {
    display: grid;
    gap: 1rem;
    grid-template-columns: minmax(0, 1.8fr) minmax(260px, 0.8fr);
    margin-top: 1.5rem;
  }

  .lane,
  .gold-box {
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    padding: 1.25rem;
  }

  .lane {
    align-items: center;
    display: grid;
    gap: 1rem;
    grid-column: 1;
    grid-template-columns: minmax(0, 1fr) auto;
  }

  .lane span {
    color: var(--color-text);
    font-weight: 800;
    white-space: nowrap;
  }

  .automated {
    border-color: color-mix(in srgb, var(--color-ok) 45%, var(--color-border));
  }

  .review {
    border-color: color-mix(in srgb, var(--color-brand-slate) 45%, var(--color-border));
  }

  .blocked {
    border-color: color-mix(in srgb, var(--color-danger) 45%, var(--color-border));
  }

  .gold-box {
    grid-column: 2;
    grid-row: 1 / span 3;
  }

  .gold-box strong {
    color: var(--color-brand-amber);
    display: block;
    font-size: 1.8rem;
    line-height: 1;
    margin-bottom: 1rem;
    text-transform: uppercase;
  }

  .gold-box ul {
    color: var(--color-text-muted);
    line-height: 1.7;
    margin: 0;
    padding-left: 1.1rem;
  }

  .impact-row {
    border-top: 1px solid var(--color-border);
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: 1.5rem;
    padding-top: 1.5rem;
  }

  .impact-row div {
    display: grid;
    gap: 0.35rem;
  }

  .impact-row strong {
    text-transform: uppercase;
  }

  .article-grid {
    align-items: start;
    display: grid;
    gap: 2rem;
    grid-template-columns: minmax(0, 1.3fr) minmax(280px, 0.7fr);
  }

  .article-copy {
    max-width: 820px;
  }

  .quote-card {
    padding: 2rem;
  }

  .quote-card span {
    color: var(--color-brand-amber);
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .quote-card blockquote {
    border-left: 3px solid var(--color-brand-amber);
    font-size: 1.35rem;
    margin: 1rem 0 0;
    padding-left: 1rem;
  }

  .cta-card {
    align-items: center;
    justify-content: space-between;
    margin-top: 0;
    padding: 2rem;
  }

  .cta-card > div {
    max-width: 760px;
  }

  @media (max-width: 980px) {
    .use-hero-grid,
    .story-grid,
    .article-grid,
    .lanes {
      grid-template-columns: 1fr;
    }

    .journey-row,
    .workflow-steps,
    .impact-row {
      grid-template-columns: 1fr;
    }

    .journey-arrow {
      display: none;
    }

    .gold-box,
    .lane {
      grid-column: auto;
      grid-row: auto;
    }

    .lane {
      grid-template-columns: 1fr;
    }

    .lane span {
      white-space: normal;
    }
  }

  @media (max-width: 640px) {
    .use-hero {
      padding-top: 5.5rem;
    }

    .hero-actions,
    .cta-card {
      align-items: stretch;
      flex-direction: column;
    }
  }
</style>
