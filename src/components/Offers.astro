---
import { siteConfig } from '../config.ts';

const offerings = [
  {
    label: 'Available: software engineering',
    name: 'AI Workflows & Operating Systems',
    description: 'Design, integrate and improve software that coordinates real work, from supplier data and orders to approvals, fulfillment and reporting.',
    includes: ['System and data-source mapping', 'Agent and rules-based workflow development', 'ERP, commerce and logistics integrations', 'Human approval, testing and auditability'],
  },
  {
    label: 'Applied research: project-scoped',
    name: 'Analytics & Advanced Reasoning',
    description: 'Use mathematical optimization, evidence relationships and structured analytical logic to tackle problems that ordinary prompt-based automation cannot solve.',
    includes: ['Optimization and predictive models', 'Decision support and scenario analysis', 'Evidence-linked reasoning systems', 'Prototype validation and iteration'],
  },
  {
    label: 'Planned expansion: inquire about R&D',
    name: 'Product Engineering & Micro-Manufacturing',
    description: 'Developing a small-batch contract R&D pathway for electronic products and molded components. Current engagements require a separate feasibility and capability review.',
    includes: ['Concept, requirements and design review', '3D printed prototypes and fixtures (planned)', 'PCB placement, reflow and testing workflow (planned)', 'CNC tooling and injection molding (planned)'],
  },
];
---

<section id="ai-office" class="section ai-office-section">
  <div class="site-shell">
    <div class="section-heading">
      <p class="eyebrow">Ways to engage</p>
      <h2>Engineering that moves from idea to operating system.</h2>
      <p>Work with Fulcrum on an intelligent workflow, a complex analytical problem, or a product R&D concept. Engagements are scoped around feasibility, validation and practical business value.</p>
    </div>

    <div class="offer-grid">
      {offerings.map((offer) => (
        <article class="offer-card">
          <span class="offer-label">{offer.label}</span>
          <h3>{offer.name}</h3>
          <p>{offer.description}</p>
          <ul>{offer.includes.map((item) => <li>{item}</li>)}</ul>
        </article>
      ))}
    </div>

    <div class="office-note">
      <p><strong>Built where accountability matters.</strong> Fulcrum favors verifiable inputs, explicit constraints, repeatable engineering and human review for high-impact decisions. Planned manufacturing capabilities are not yet advertised as production-ready.</p>
      <a class="btn btn-primary" href={siteConfig.site.workflowMailto}>Discuss a Project</a>
    </div>
  </div>

  <style>
    .ai-office-section { border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); background: var(--color-surface); }
    .offer-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
    .offer-card, .office-note { border: 1px solid var(--color-border); border-radius: 8px; background: var(--color-bg); box-shadow: var(--shadow-soft); }
    .offer-card { padding: 26px; }
    .offer-label { color: var(--color-brand-amber); font-size: .74rem; font-weight: 850; text-transform: uppercase; letter-spacing: .035em; }
    .offer-card h3 { margin: 18px 0 0; color: var(--color-text); font-size: 1.35rem; line-height: 1.2; }
    .offer-card p, .offer-card li, .office-note p { color: var(--color-text-muted); line-height: 1.58; }
    .offer-card p { margin: 18px 0 0; }
    .offer-card ul { display: grid; gap: 9px; margin: 22px 0 0; padding-left: 20px; }
    .office-note { display: flex; align-items: center; justify-content: space-between; gap: 28px; margin-top: 18px; padding: 22px 26px; }
    .office-note p { max-width: 780px; margin: 0; }
    .office-note strong { color: var(--color-text); }
    @media (max-width: 980px) { .offer-grid { grid-template-columns: 1fr; } }
    @media (max-width: 760px) { .offer-card { padding: 22px; } .office-note { flex-direction: column; align-items: stretch; } }
  </style>
</section>
