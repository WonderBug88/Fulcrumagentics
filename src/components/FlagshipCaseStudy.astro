---
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';
import { siteConfig } from '../config.ts';

const videoPath = '/assets/video/fulcrum-founder-transformation.mp4';
const hasVideo = existsSync(
  resolve('public/assets/video/fulcrum-founder-transformation.mp4'),
);

const stages = [
  {
    number: '01',
    title: 'Success created complexity',
    description:
      'Orders grew, channels multiplied, and the founder became the person connecting supplier files, catalog decisions, customer needs, fulfillment, and reporting.',
  },
  {
    number: '02',
    title: 'Speed exposed the bottleneck',
    description:
      'Competitors began responding in hours while important decisions still waited for the founder to find the context, check the risk, and push the next step.',
  },
  {
    number: '03',
    title: 'Fulcrum installed an AI office',
    description:
      'Fulcrum mapped the business, selected the highest-value workflow, connected the authoritative systems, and built review and escalation into the operating loop.',
  },
  {
    number: '04',
    title: 'The business learned to move without guessing',
    description:
      'Repeatable work moved faster, risky actions stayed reviewable, and the founder returned attention to customers, leadership, and the next growth decision.',
  },
];

const systems = [
  'Catalog',
  'Orders',
  'Supplier data',
  'Customer service',
  'Analytics',
  'Shipping',
  'Finance',
];
---

<section id="flagship" class="section flagship-section">
  <div class="site-shell">
    <div class="section-heading section-heading-left flagship-heading">
      <p class="eyebrow">Flagship transformation</p>
      <h2>The founder should not be the integration layer.</h2>
      <p>
        The company is successful. That is why the hidden operating debt finally
        matters. Fulcrum turns the founder's context, approvals, and recurring
        decisions into a controlled AI capability the team can run.
      </p>
    </div>

    <div class="flagship-media">
      <div class="case-film">
        {
          hasVideo ? (
            <video controls playsinline preload="metadata" aria-label="Fulcrum founder transformation film">
              <source src={videoPath} type="video/mp4" />
              Your browser does not support HTML video.
            </video>
          ) : (
            <div class="case-film-placeholder">
              <img
                src="/assets/proof/route-authority-results.png"
                alt="A controlled Fulcrum workflow showing reviewable results and operating states"
                loading="lazy"
                decoding="async"
              />
              <div>
                <span>Flagship operating proof</span>
                <strong>From founder bottleneck to controlled AI office</strong>
                <small>Built from real operating systems, review states, and production boundaries.</small>
              </div>
            </div>
          )
        }
      </div>

      <aside class="flagship-principle">
        <p class="eyebrow">The operating principle</p>
        <h3>Connect in controlled stages—not one risky handoff.</h3>
        <p>
          Fulcrum does not point an autonomous agent at the entire company. We
          identify one valuable operating loop, make its sources and decisions
          explicit, prove it on real data, and expand from measured results.
        </p>
        <div class="system-list" aria-label="Example connected business systems">
          {systems.map((system) => <span>{system}</span>)}
        </div>
      </aside>
    </div>

    <div class="flagship-stages" aria-label="Flagship founder transformation">
      {
        stages.map((stage) => (
          <article>
            <span>{stage.number}</span>
            <h3>{stage.title}</h3>
            <p>{stage.description}</p>
          </article>
        ))
      }
    </div>

    <div class="flagship-cta">
      <div>
        <strong>Start where speed, cost, or risk is already visible.</strong>
        <span>Bring one workflow that repeatedly comes back to the founder.</span>
      </div>
      <a class="btn btn-primary" href={siteConfig.site.workflowMailto}>
        Start a Workflow Diagnostic
      </a>
    </div>
  </div>

  <style>
    .flagship-section {
      border-bottom: 1px solid var(--color-border);
      background: color-mix(in srgb, var(--color-surface-2) 48%, var(--color-bg));
    }

    .flagship-heading {
      max-width: 900px;
    }

    .flagship-media {
      display: grid;
      grid-template-columns: minmax(0, 1.45fr) minmax(300px, 0.55fr);
      gap: 18px;
      align-items: stretch;
    }

    .case-film,
    .flagship-principle,
    .flagship-stages article,
    .flagship-cta {
      overflow: hidden;
      border: 1px solid var(--color-border);
      border-radius: 8px;
      background: var(--color-surface);
      box-shadow: var(--shadow-soft);
    }

    .case-film {
      min-height: 390px;
    }

    .case-film video,
    .case-film-placeholder {
      display: block;
      width: 100%;
      height: 100%;
      min-height: 390px;
      aspect-ratio: 16 / 9;
    }

    .case-film video {
      background: var(--color-brand-navy);
      object-fit: cover;
    }

    .case-film-placeholder {
      position: relative;
      background: var(--color-brand-navy);
    }

    .case-film-placeholder::after {
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, transparent 28%, rgba(9, 24, 44, 0.92) 100%);
      content: '';
    }

    .case-film-placeholder img {
      width: 100%;
      height: 100%;
      min-height: 390px;
      object-fit: cover;
      object-position: top left;
      opacity: 0.58;
    }

    .case-film-placeholder div {
      position: absolute;
      right: 24px;
      bottom: 24px;
      left: 24px;
      z-index: 1;
      display: grid;
      gap: 6px;
      color: white;
    }

    .case-film-placeholder span {
      color: var(--color-brand-amber);
      font-size: 0.75rem;
      font-weight: 850;
      text-transform: uppercase;
    }

    .case-film-placeholder strong {
      font-size: clamp(1.35rem, 3vw, 2.2rem);
      line-height: 1.1;
    }

    .case-film-placeholder small {
      max-width: 620px;
      color: rgba(255, 255, 255, 0.76);
      line-height: 1.45;
    }

    .flagship-principle {
      padding: 28px;
    }

    .flagship-principle h3 {
      margin: 0;
      color: var(--color-text);
      font-size: clamp(1.45rem, 3vw, 2.3rem);
      line-height: 1.08;
    }

    .flagship-principle > p:not(.eyebrow) {
      margin: 18px 0 0;
      color: var(--color-text-muted);
      line-height: 1.65;
    }

    .system-list {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 24px;
    }

    .system-list span {
      border: 1px solid var(--color-border);
      border-radius: 999px;
      background: var(--color-surface-2);
      padding: 7px 10px;
      color: var(--color-text-muted);
      font-size: 0.8rem;
      font-weight: 750;
    }

    .flagship-stages {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 14px;
      margin-top: 18px;
    }

    .flagship-stages article {
      padding: 22px;
    }

    .flagship-stages article > span {
      color: var(--color-brand-amber);
      font-size: 0.8rem;
      font-weight: 900;
    }

    .flagship-stages h3 {
      margin: 22px 0 0;
      color: var(--color-text);
      font-size: 1.05rem;
      line-height: 1.25;
    }

    .flagship-stages p {
      margin: 12px 0 0;
      color: var(--color-text-muted);
      line-height: 1.58;
    }

    .flagship-cta {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      margin-top: 18px;
      padding: 22px;
    }

    .flagship-cta div {
      display: grid;
      gap: 5px;
    }

    .flagship-cta strong {
      color: var(--color-text);
      font-size: 1.05rem;
    }

    .flagship-cta span {
      color: var(--color-text-muted);
    }

    @media (max-width: 980px) {
      .flagship-media {
        grid-template-columns: 1fr;
      }

      .flagship-stages {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 760px) {
      .case-film,
      .case-film video,
      .case-film-placeholder,
      .case-film-placeholder img {
        min-height: 250px;
      }

      .flagship-stages {
        grid-template-columns: 1fr;
      }

      .flagship-cta {
        align-items: stretch;
        flex-direction: column;
      }
    }
  </style>
</section>
