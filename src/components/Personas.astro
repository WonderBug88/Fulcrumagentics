---
const painPoints = [
  {
    title: 'Demo-to-Deployment Cliff',
    description:
      'The first demo works because the problem is controlled. Real operations break when formats change, APIs fail, users enter bad data, or the edge case shows up.',
  },
  {
    title: 'Botsitting Tax',
    description:
      'The owner or best employee becomes the AI supervisor: approving, correcting, retrying, debugging, and asking what comes next all day.',
  },
  {
    title: 'Context Treadmill',
    description:
      'Every session requires reloading the business rules, exceptions, customer history, source records, and desired output before useful work can happen.',
  },
  {
    title: 'Trust Gap',
    description:
      'A 95% correct answer can still create work if the wrong 5% touches customers, inventory, legal evidence, shipping, money, or production systems.',
  },
  {
    title: 'Workflow Drift',
    description:
      'Patch by patch, the AI app drifts away from the original job until nobody knows what it does, why it did it, or whether it should be trusted.',
  },
];

const personas = [
  {
    name: 'The Operations Bottleneck Founder',
    who: 'Ecommerce owners, distributors, manufacturers, hospitality operators, and service businesses.',
    pain:
      'Too many spreadsheets, supplier updates, SKU decisions, pricing changes, inbox interruptions, and manual approvals.',
    wants: 'Make the business run without touching every process personally.',
    employee: 'Supplier intake, catalog QA, pricing review, publishing, reporting, and exception routing.',
  },
  {
    name: 'The Evidence Worker',
    who: 'Attorneys, insurance analysts, compliance teams, investigators, and document-heavy professionals.',
    pain:
      'Thousands of pages, emails, attachments, timelines, claims, weak spots, and source records that must stay defensible.',
    wants: 'Find the answer and show the proof.',
    employee: 'Evidence search, chronology building, claim tables, source-backed summaries, and handoff exports.',
  },
  {
    name: 'The Growth-Constrained Team',
    who: 'Ten to two-hundred person companies, regional operators, PE-backed businesses, and fast-growing teams.',
    pain:
      'They need more capacity, but another hire adds payroll, training, management, and risk before the process is stable.',
    wants: 'Scale output without scaling headcount at the same rate.',
    employee: 'Inbox triage, sales follow-up, customer workflows, reporting, data cleanup, and back-office coordination.',
  },
  {
    name: 'The Tribal Knowledge Company',
    who: 'Family businesses, legacy companies, multi-location teams, and organizations with long-tenured employees.',
    pain:
      'One person knows how everything works, but the knowledge lives in memory, email threads, old spreadsheets, and habits.',
    wants: 'Turn tribal knowledge into a process the company can actually run.',
    employee: 'SOP capture, knowledge routing, decision support, training support, and institutional memory workflows.',
  },
  {
    name: 'The Compliance-Conscious Operator',
    who: 'Healthcare, finance, legal, procurement, fulfillment, hospitality, and regulated or reputation-sensitive teams.',
    pain:
      'They want automation, but mistakes matter and AI cannot be allowed to run loose without review boundaries.',
    wants: 'Automate safely without losing control.',
    employee: 'Approval gates, audit trails, risk holds, permission checks, escalation rules, and accountable production writes.',
  },
];
---

<section id="personas" class="section personas-section">
  <div class="site-shell">
    <div class="section-heading section-heading-left">
      <p class="eyebrow">Who hires Fulcrum</p>
      <h2>For teams that are tired of babysitting AI.</h2>
      <p>
        The pain is not access to AI. The pain is turning AI into a dependable
        business role that keeps working after the demo, after the exceptions,
        and after the first rebuild.
      </p>
    </div>

    <div class="pain-grid" aria-label="AI implementation pain points">
      {painPoints.map((point) => (
        <article class="pain-card">
          <h3>{point.title}</h3>
          <p>{point.description}</p>
        </article>
      ))}
    </div>

    <div class="persona-heading">
      <p class="eyebrow">Best-fit buyers</p>
      <h3>Fulcrum is strongest where AI touches real work, real systems, and real accountability.</h3>
    </div>

    <div class="persona-grid" aria-label="Fulcrum Agentics customer personas">
      {personas.map((persona) => (
        <article class="persona-card">
          <h3>{persona.name}</h3>
          <dl>
            <div>
              <dt>Who</dt>
              <dd>{persona.who}</dd>
            </div>
            <div>
              <dt>Pain</dt>
              <dd>{persona.pain}</dd>
            </div>
            <div>
              <dt>Wants</dt>
              <dd>{persona.wants}</dd>
            </div>
            <div>
              <dt>AI employee</dt>
              <dd>{persona.employee}</dd>
            </div>
          </dl>
        </article>
      ))}
    </div>
  </div>

  <style>
    .personas-section {
      border-top: 1px solid var(--color-border);
      border-bottom: 1px solid var(--color-border);
      background: color-mix(in srgb, var(--color-surface-2) 52%, var(--color-bg));
    }

    .pain-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
      gap: 14px;
      margin: 0 0 38px;
    }

    .pain-card,
    .persona-card {
      border: 1px solid var(--color-border);
      border-radius: 8px;
      background: var(--color-surface);
      box-shadow: var(--shadow-soft);
    }

    .pain-card {
      padding: 20px;
    }

    .pain-card h3,
    .persona-card h3,
    .persona-heading h3 {
      margin: 0;
      color: var(--color-text);
      font-weight: 850;
      line-height: 1.2;
    }

    .pain-card h3 {
      font-size: 1rem;
    }

    .pain-card p {
      margin: 12px 0 0;
      color: var(--color-text-muted);
      line-height: 1.58;
    }

    .persona-heading {
      max-width: 780px;
      margin-bottom: 24px;
    }

    .persona-heading h3 {
      font-size: clamp(1.5rem, 3vw, 2.35rem);
    }

    .persona-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 18px;
    }

    .persona-card {
      padding: 24px;
    }

    .persona-card h3 {
      font-size: 1.16rem;
    }

    .persona-card dl {
      display: grid;
      gap: 14px;
      margin: 22px 0 0;
    }

    .persona-card dt {
      color: var(--color-brand-amber);
      font-size: 0.74rem;
      font-weight: 850;
      text-transform: uppercase;
    }

    .persona-card dd {
      margin: 5px 0 0;
      color: var(--color-text-muted);
      line-height: 1.55;
    }

    @media (max-width: 760px) {
      .pain-card,
      .persona-card {
        padding: 20px;
      }
    }
  </style>
</section>
