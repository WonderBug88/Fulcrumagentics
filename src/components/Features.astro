---
import { siteConfig } from '../config.ts';
import { controlFeatures } from '../content/features';
---

<section id="control" class="section section-quiet">
  <div class="site-shell">
    <div class="section-heading">
      <p class="eyebrow">Control layer</p>
      <h2>{siteConfig.features.title}</h2>
      <p>{siteConfig.features.subtitle}</p>
    </div>

    <div class="control-grid">
      {controlFeatures.map((feature, index) => (
        <article class="control-card">
          <span class="card-index">{String(index + 1).padStart(2, '0')}</span>
          <h3>{feature.title}</h3>
          <p>{feature.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>
