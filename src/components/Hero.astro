---
import { siteConfig } from '../config.ts';
---

<section class="hero-section">
  <div class="site-shell hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">{siteConfig.hero.eyebrow}</p>
      <h1 aria-label={siteConfig.hero.headline}>
        {siteConfig.hero.headlineLines.map((line) => (
          <span>{line}</span>
        ))}
      </h1>
      <p class="hero-description">{siteConfig.hero.description}</p>

      <div class="hero-actions">
        <a href={siteConfig.hero.cta.primary.href} class="btn btn-primary">
          {siteConfig.hero.cta.primary.text}
        </a>
        <a href={siteConfig.hero.cta.secondary.href} class="btn btn-secondary">
          {siteConfig.hero.cta.secondary.text}
        </a>
      </div>

      <ul class="proof-list" aria-label="Workflow controls">
        {siteConfig.hero.proofPoints.map((point) => (
          <li>{point}</li>
        ))}
      </ul>
    </div>

    <div class="workflow-visual" aria-label="Controlled workflow visual">
      <div class="workflow-window">
        <div class="window-topline">
          <span>{siteConfig.hero.console.title}</span>
          <strong>Operator review required</strong>
        </div>

        <div class="workflow-rows">
          {siteConfig.hero.console.rows.map((row) => (
            <div class="workflow-row">
              <span>{row.label}</span>
              <p>{row.value}</p>
            </div>
          ))}
        </div>

        <div class="decision-strip">
          <span>Hold</span>
          <span>Fix Source</span>
          <span>Approve</span>
          <span>Audit</span>
        </div>
      </div>
    </div>
  </div>

  <div class="site-shell hero-stats" aria-label="Fulcrum operating principles">
    {siteConfig.hero.stats.map((stat) => (
      <div>
        <strong>{stat.value}</strong>
        <span>{stat.label}</span>
      </div>
    ))}
  </div>
</section>
