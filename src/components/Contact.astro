---
import { siteConfig } from '../config.ts';
---

<section id="contact" class="contact-section">
  <div class="site-shell contact-panel">
    <div>
      <p class="eyebrow">Start with one workflow</p>
      <h2>{siteConfig.contact.title}</h2>
      <p>{siteConfig.contact.subtitle}</p>
    </div>

    <div class="contact-action">
      <ul>
        {siteConfig.contact.benefits.map((benefit) => (
          <li>{benefit}</li>
        ))}
      </ul>

      <a href={siteConfig.contact.href} class="btn btn-primary">
        {siteConfig.contact.cta}
      </a>
      <a href={`mailto:${siteConfig.contact.email}`} class="email-link">
        {siteConfig.contact.email}
      </a>
    </div>
  </div>
</section>
