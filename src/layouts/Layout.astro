---
const { title = 'Fulcrum Agentics', description = '' } = Astro.props;
import ThemeSwitcher from '../components/ThemeSwitcher.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}

    <script is:inline>
      (() => {
        const key = 'fa-theme';
        const root = document.documentElement;

        let saved = 'light';
        try {
          saved = localStorage.getItem(key) === 'dark' ? 'dark' : 'light';
        } catch {}

        root.classList.remove('theme-light', 'theme-dark');
        root.classList.add(saved === 'dark' ? 'theme-dark' : 'theme-light');
      })();
    </script>
  </head>

  <body>
    <header class="site-shell site-header">
      <a href="/" class="site-brand" aria-label="Fulcrum Agentics home">
        <img
          src="/assets/fulcrum-mark.svg"
          alt="Fulcrum Agentics"
          width="48"
          height="48"
          loading="eager"
          decoding="async"
        />
      </a>
      <ThemeSwitcher />
    </header>

    <slot />
  </body>
</html>
